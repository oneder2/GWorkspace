{
  "rewrites": [
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "(?<preview>.*)\\.vercel\\.app" }],
      "destination": "https://workspace.gellaronline.cc/api/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/sites",
      "destination": "/workspace",
      "permanent": true
    },
    {
      "source": "/tools",
      "destination": "/workspace",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
